  "edges": [
    {
      "id": "dns-query",
      "source": "users",
      "target": "dns",
      "label": "DNS",
      "kind": "dns"
    },
    {
      "id": "https",
      "source": "users",
      "target": "cdn",
      "label": "HTTPS"
    },
    {
      "id": "api-origin",
      "source": "cdn",
      "target": "api",
      "label": "/api/*"
    },
    {
      "id": "site-origin",
      "source": "cdn",
      "target": "site",
      "label": "Static assets"
    },
    {
      "id": "authorizer",
      "source": "api",
      "target": "auth",
      "label": "JWT authorizer",
      "kind": "association"
    },
    {
      "id": "invoke",
      "source": "api",
      "target": "fn",
      "label": "Invoke"
    },
    {
      "id": "orders",
      "source": "fn",
      "target": "table",
      "label": "Read / write"
    },
    {
      "id": "enqueue",
      "source": "fn",
      "target": "queue",
      "label": "Order placed",
      "kind": "event"
    },
    {
      "id": "poll",
      "source": "queue",
      "target": "worker",
      "label": "Batch",
      "kind": "event"
    },
    {
      "id": "update",
      "source": "worker",
      "target": "table",
      "label": "Update status"
    },
    {
      "id": "telemetry",
      "source": "worker",
      "target": "logs",
      "label": "Logs",
      "kind": "management"
    }
  ],
  "notes": [
    "Illustrative routes and names; Lambda runs outside any VPC in this view."
  ]
}
