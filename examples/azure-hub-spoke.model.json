  "edges": [
    {
      "id": "s2s",
      "source": "router",
      "target": "vpngw",
      "label": "Site-to-site VPN",
      "kind": "connectivity"
    },
    {
      "id": "peer-a",
      "source": "hub",
      "target": "spoke-a",
      "label": "Peering",
      "kind": "connectivity"
    },
    {
      "id": "peer-b",
      "source": "hub",
      "target": "spoke-b",
      "label": "Peering",
      "kind": "connectivity"
    },
    {
      "id": "egress",
      "source": "aks",
      "target": "fw",
      "label": "UDR 0.0.0.0/0"
    },
    {
      "id": "data",
      "source": "fw",
      "target": "pe",
      "label": "TCP 1433"
    },
    {
      "id": "link",
      "source": "pe",
      "target": "sql",
      "label": "Private Link"
    },
    {
      "id": "diag",
      "source": "aks",
      "target": "logs",
      "label": "Diagnostics",
      "kind": "management"
    }
  ],
  "notes": [
    "Spoke traffic, including SQL through the Private Endpoint, is routed to the firewall by UDR; DNS zones for Private Link are not drawn."
  ]
